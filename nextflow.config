   // nextflow.config

    def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
    report {
        enabled = true
        file    = "report_${trace_timestamp}.html"
    }

    timeline {
        enabled = true
        file    = "timeline_${trace_timestamp}.html"
    }

    trace {
        enabled = true
        file    = "trace_${trace_timestamp}.txt"
    }

    dag {
        enabled = true
        file    = "dag_${trace_timestamp}.html"
    }

    process {
    // --- Defaults applied to ALL processes ---
    executor = 'slurm'
    queue = 'short' // max 12 hours -- use 'campus-new' for longer jobs
    time     = '1h'
    cpus     = 4
    memory   = '16 GB'
    maxRetries = 2
    errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
    //maxForks   = 50   // ← equivalent to %50 in SLURM arrays

    // --- Overrides for specific processes ---
    withName: 'MIXCR_ANALYZE' {
        time   = { '1h' * task.attempt }
        cpus   = 4
        memory = { 16.GB * task.attempt }
        maxRetries = 2
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        //maxForks   = 50   // ← equivalent to %50 in SLURM arrays
    }

    withLabel: 'gpu_process' {
        executor = 'slurm'
        queue = 'chorus' // Use the chorus partition
        clusterOptions = '--gres=gpu:1' // Request 1 GPU
        cpus   = 4
        //time   = { '2h' * task.attempt }
        //memory = { 32.GB * task.attempt }
        memory = { [16.GB * Math.pow(2, task.attempt - 1), 128.GB].min() }
        time   = { [2.hour * Math.pow(2, task.attempt - 1), 48.hour].min() }
        maxRetries = 1
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        //maxForks   = 6
        
        // Alternative for specific models on standard partitions:
        // clusterOptions = '--partition=short --gpus=rtx2080ti:1'
    }

    withLabel: 'gpu_pairing' {
        executor = 'slurm'
        queue = 'chorus' // Use the chorus partition
        clusterOptions = '--gres=gpu:1' // Request 1 GPU
        cpus   = 4
        //time   = { '2h' * task.attempt }
        //memory = { 32.GB * task.attempt }
        memory = { [16.GB * Math.pow(2, task.attempt - 1), 128.GB].min() }
        time   = { [2.hour * Math.pow(2, task.attempt - 1), 48.hour].min() }
        maxRetries = 0
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        //maxForks   = 6
        
        // Alternative for specific models on standard partitions:
        // clusterOptions = '--partition=short --gpus=rtx2080ti:1'
    }

    withLabel: 'gpu_process_24hr' {
        executor = 'slurm'
        queue = 'chorus' // Use the chorus partition
        clusterOptions = '--gres=gpu:1' // Request 1 GPU
        time   = '24h'
        cpus   = 4
        memory = '128 GB'
        //maxForks   = 6
        maxRetries = 0
        // Alternative for specific models on standard partitions:
        // clusterOptions = '--partition=short --gpus=rtx2080ti:1'
    }

    withLabel: 'cpu_pairing' {
        executor      = 'slurm'
        queue         = 'short'
        time          = '6h'
        cpus          = 2
        memory        = '16 GB'
        errorStrategy = 'retry'
        maxRetries    = 0
    }

    withLabel: 'big_job' {
        cpus   = 16
        memory = '128 GB'
        time   = '12h'
    }

    withLabel: 'quick' {
        time   = '15m'
        memory = '2 GB'
        cpus   = 1
    }

    withLabel: 'cpu_1h' {
        executor = 'slurm'
        queue = 'short' // max 12 hours -- use 'campus-new' for longer jobs
        time     = '1h'
        cpus     = 4
        memory   = '24 GB'
        maxRetries = 0
    }
    }